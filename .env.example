# ═══════════════════════════════════════════════════════════════
# AzFIT Environment Variables
# Copy this file to `.env` and fill in values for your environment.
# ═══════════════════════════════════════════════════════════════

# ─── Environment Strategy ─────────────────────────────────────
# dev  = local Vite dev server (port 3000 by default)
#        Can use a local Supabase stack or the live staging project.
# staging = auto-deployed preview from pull requests / main
#           Use a dedicated Supabase project and Sentry/PostHog projects.
# prod = manual promotion from staging
#        Use production Supabase, Sentry, and PostHog/Plausible projects.

# ─── Supabase (required) ──────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Storage (required for Phase 4 progress photo uploads)
VITE_SUPABASE_STORAGE_URL=https://your-project-id.supabase.co/storage/v1

# ─── Error Tracking: Sentry (optional) ─────────────────────────
# Leave VITE_SENTRY_DSN empty to disable runtime error reporting.
VITE_SENTRY_DSN=https://your-sentry-dsn-here@o0.ingest.sentry.io/0

# Source-map upload to Sentry during production builds (optional).
# Only used by vite.config.ts; leave empty and source maps stay local.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project

# ─── Product Analytics: PostHog + Plausible (optional) ──────────
VITE_POSTHOG_KEY=your-posthog-project-api-key
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_PLAUSIBLE_DOMAIN=azfit.github.io

# ─── App Configuration ──────────────────────────────────────────
VITE_APP_NAME=AzFIT Coaching

# ─── Admin Quick Login (DEV ONLY) ─────────────────────────────
# The admin quick-login button only renders in `import.meta.env.DEV`.
# Leave VITE_ADMIN_PASSWORD empty to disable admin bypass even in dev.
VITE_ADMIN_EMAIL=admin@azfit.ai
VITE_ADMIN_PASSWORD=

# ─── Web Push (VAPID) ─────────────────────────────────────────
# VAPID *public* key — public by design, safe to commit. The private
# key must NEVER be committed: set it as the send-push edge function
# secret at deploy time (see supabase/functions/send-push/README.md).
VITE_VAPID_PUBLIC_KEY=BNsM4mJsBn93S3XntG3QAsCl5NTWlP4HPY0DfSiAsaLMa4BlXr8tZjwKPJx8w6Y-6YB9bMscyDSuBZNl2Ac2AFo

# ─── Notes ──────────────────────────────────────────────────────
# Do not commit real `.env` files. CI should inject secrets via
# repository / environment variables, not by committing them.
# See `.github/workflows/ci.yml` for how CI uses these variables.
