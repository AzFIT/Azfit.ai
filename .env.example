# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Storage (for Phase 4 progress photo uploads)
VITE_SUPABASE_STORAGE_URL=https://your-project-id.supabase.co/storage/v1

# Sentry error tracking (optional — leave DSN empty to disable)
VITE_SENTRY_DSN=https://your-sentry-dsn-here@o0.ingest.sentry.io/0
# Source-map upload for Sentry (only used during build)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project

